{
    "compilerOptions": {
        "module": "preserve",
        "target": "ES2020",
        "lib": [
            "ES2020"
        ],
        "outDir": "out",
        "rootDir": ".",
        "sourceMap": true,
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true,
        "moduleResolution": "bundler"
    },
    "include": [
        "src",
        "test"
    ],
    "exclude": [
        "node_modules",
        ".vscode-test",
        "dist",
        "out"
    ]
}